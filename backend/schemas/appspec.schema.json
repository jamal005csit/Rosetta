{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "appspec",
    "type": "object",
    "required": ["app", "screens", "flows", "rules", "sample_data", "journey", "coverage"],
    "properties": {
      "app": {"type": "object", "required": ["name", "domain", "language", "direction"],
        "properties": {"name": {"type": "string"}, "domain": {"type": "string"},
          "language": {"type": "string"}, "direction": {"type": "string", "enum": ["ltr", "rtl"]}}},
      "screens": {"type": "array", "minItems": 1, "items": {"type": "object",
        "required": ["id", "title", "fields", "shortcuts", "evidence"],
        "properties": {"id": {"type": "string"}, "title": {"type": "string"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "fields": {"type": "array", "items": {"type": "object",
            "required": ["id", "label", "type", "required", "enabled", "evidence"],
            "properties": {"id": {"type": "string"}, "label": {"type": "string"},
              "type": {"type": "string"}, "required": {"type": "boolean"},
              "enabled": {"type": "boolean"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
          "shortcuts": {"type": "array", "items": {"type": "object",
            "required": ["key", "action", "evidence"],
            "properties": {"key": {"type": "string"}, "action": {"type": "string"},
              "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}}}}},
      "flows": {"type": "array", "items": {"type": "object",
        "required": ["from", "to", "trigger", "evidence"],
        "properties": {"from": {"type": "string"}, "to": {"type": "string"},
          "trigger": {"type": "string"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
      "rules": {"type": "array", "items": {"type": "object",
        "required": ["id", "kind", "description", "examples", "confidence"],
        "properties": {"id": {"type": "string"},
          "kind": {"type": "string", "enum": ["calculation", "validation", "conditional"]},
          "description": {"type": "string"},
          "examples": {"type": "array", "minItems": 1, "items": {"type": "object",
            "required": ["inputs", "output", "evidence"],
            "properties": {"inputs": {"type": "object"}, "output": {"type": "string"},
              "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
      "sample_data": {"type": "object"},
      "journey": {"type": "array", "minItems": 1, "items": {"type": "object",
        "required": ["step", "weight", "action", "target", "expect", "legacy_frame"],
        "properties": {"step": {"type": "integer"}, "weight": {"type": "integer", "enum": [1, 2]},
          "action": {"type": "string", "enum": ["click", "type", "key", "select"]},
          "target": {"type": "string"}, "value": {"type": ["string", "null"]},
          "expect": {"type": "object", "required": ["screen"],
            "properties": {"screen": {"type": "string"},
              "values": {"type": "object"}, "messages": {"type": "array", "items": {"type": "string"}}}},
          "legacy_frame": {"type": "string"}}}},
      "coverage": {"type": "object", "required": ["unverified"],
        "properties": {"unverified": {"type": "array", "items": {"type": "object",
          "required": ["item", "reason"],
          "properties": {"item": {"type": "string"}, "reason": {"type": "string"}}}}}}
    }
  }