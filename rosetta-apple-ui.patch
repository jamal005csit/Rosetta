+/* Rosetta — an Apple-style interface.
+   Structure: tokens → base → shell → components → responsive → accessibility.
+   Two layers: a quiet content layer (opaque grouped surfaces) and a floating
+   functional layer (sidebar, top bar, tab bar) that uses the glass material. */
+
+@import url('https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&display=swap');
+
+@property --ai-angle { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
+
+/* ───────────── Tokens ───────────── */
+:root {
+  color-scheme: light dark;
+
+  /* SF Pro on Apple devices, Inter (closest match, with optical sizing) elsewhere */
+  --font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', 'Inter', system-ui, 'Segoe UI', Roboto, sans-serif;
+  --mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
+
+  /* Light appearance. Every text pairing below is ≥ 4.5:1 on the surface it sits on. */
+  --bg: #f2f2f7;
+  --surface: #ffffff;
+  --surface-2: #f7f7fa;
+  --fill: rgba(120, 120, 128, .12);
+  --fill-hover: rgba(120, 120, 128, .2);
+  --label: #1d1d1f;
+  --label-2: #5c5c61;
+  --sep: rgba(60, 60, 67, .16);
+  --sep-strong: rgba(60, 60, 67, .32);
+  --card-edge: rgba(0, 0, 0, .06);
+
+  --accent: #0071e3;
+  --accent-hover: #0077ed;
+  --accent-text: #0066cc;
+  --accent-tint: rgba(0, 113, 227, .12);
+
+  --green: #34c759;
+  --green-text: #1b7a36;
+  --green-tint: rgba(52, 199, 89, .16);
+  --red: #ff3b30;
+  --red-text: #c5221a;
+  --red-tint: rgba(255, 59, 48, .12);
+
+  --glass-fill: rgba(255, 255, 255, .62);
+  --glass-edge: rgba(255, 255, 255, .78);
+  --glass-shadow: 0 10px 34px rgba(0, 0, 0, .09), 0 1px 3px rgba(0, 0, 0, .06);
+  --bar-fill: rgba(242, 242, 247, .74);
+  --wash-a: rgba(94, 92, 230, .13);
+  --wash-b: rgba(10, 132, 255, .11);
+
+  /* Intelligence gradient: text stops are tuned for ≥ 3:1 (large text); glow stops are decorative */
+  --ai-1: #e85d00; --ai-2: #d6215a; --ai-3: #a23dd1; --ai-4: #4f4cd8; --ai-5: #0071e3;
+  --ai-g1: #ff9f0a; --ai-g2: #ff375f; --ai-g3: #bf5af2; --ai-g4: #5e5ce6; --ai-g5: #0a84ff;
+
+  --ease: cubic-bezier(.22, .8, .24, 1);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #000000;
+    --surface: #1c1c1e;
+    --surface-2: #2c2c2e;
+    --fill: rgba(120, 120, 128, .24);
+    --fill-hover: rgba(120, 120, 128, .36);
+    --label: #f5f5f7;
+    --label-2: #a1a1a6;
+    --sep: rgba(84, 84, 88, .55);
+    --sep-strong: rgba(120, 120, 128, .5);
+    --card-edge: rgba(255, 255, 255, .07);
+
+    --accent-text: #4da3ff;
+    --accent-tint: rgba(10, 132, 255, .2);
+    --green-text: #5fd97d;
+    --green-tint: rgba(48, 209, 88, .2);
+    --red-text: #ff6b62;
+    --red-tint: rgba(255, 69, 58, .2);
+
+    --glass-fill: rgba(44, 44, 48, .56);
+    --glass-edge: rgba(255, 255, 255, .15);
+    --glass-shadow: 0 12px 38px rgba(0, 0, 0, .55), 0 1px 3px rgba(0, 0, 0, .5);
+    --bar-fill: rgba(0, 0, 0, .62);
+    --wash-a: rgba(94, 92, 230, .3);
+    --wash-b: rgba(10, 132, 255, .2);
+
+    --ai-1: #ff9f0a; --ai-2: #ff5a7a; --ai-3: #c77dff; --ai-4: #7d7bff; --ai-5: #4da3ff;
+  }
+}
+
+/* ───────────── Base ───────────── */
+*, *::before, *::after { box-sizing: border-box; }
+html { -webkit-text-size-adjust: 100%; scrollbar-width: thin; scrollbar-color: var(--sep-strong) transparent; }
+body {
+  margin: 0; min-width: 320px; min-height: 100vh;
+  background: var(--bg); color: var(--label);
+  font: 400 15px/1.47 var(--font); font-optical-sizing: auto;
+  -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; font-synthesis: none;
+}
+/* Something for the glass to reflect: a faint ambient wash behind everything */
+body::before {
+  content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none;
+  background:
+    radial-gradient(60vw 50vh at 88% -8%, var(--wash-a), transparent 70%),
+    radial-gradient(55vw 45vh at -4% 104%, var(--wash-b), transparent 70%);
+}
+h1, h2, h3, p { margin: 0; }
+a { color: inherit; text-decoration: none; }
+button, input { font: inherit; color: inherit; }
+button { cursor: pointer; background: none; border: 0; padding: 0; }
+::selection { background: var(--accent-tint); }
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 8px; }
+.icon { flex: none; display: block; }
+.sr-only, .skip-link:not(:focus) {
+  position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden;
+  clip: rect(0 0 0 0); white-space: nowrap; border: 0;
+}
+.skip-link:focus {
+  position: fixed; z-index: 100; top: 12px; left: 12px; padding: 10px 16px; border-radius: 999px;
+  background: var(--accent); color: #fff; font-weight: 600;
+}
+
+/* Glass: only on the floating functional layer */
+.glass {
+  background: var(--glass-fill);
+  -webkit-backdrop-filter: blur(28px) saturate(1.6); backdrop-filter: blur(28px) saturate(1.6);
+  box-shadow: var(--glass-shadow), inset 0 0 0 .5px var(--glass-edge), inset 0 1px 0 var(--glass-edge);
+}
+
+/* ───────────── Shell ───────────── */
+.app-shell { min-height: 100vh; }
+
+.sidebar {
+  position: fixed; z-index: 20; top: 12px; bottom: 12px; left: 12px; width: 232px;
+  border-radius: 26px; padding: 18px 12px 14px; display: flex; flex-direction: column;
+}
+.brand { display: flex; align-items: center; gap: 10px; height: 40px; padding: 0 10px; }
+.brand-mark {
+  width: 28px; height: 28px; flex: none; padding: 6.5px; border-radius: 8.5px;
+  display: grid; grid-template-columns: 1fr 1fr; gap: 2.5px;
+  background: linear-gradient(160deg, #4da3ff, #0071e3 55%, #5e5ce6);
+  box-shadow: inset 0 0 0 .5px rgba(255, 255, 255, .4), 0 2px 6px rgba(0, 113, 227, .35);
+}
+.brand-mark span { background: #fff; border-radius: 2px; }
+.brand-mark span:nth-child(2), .brand-mark span:nth-child(3) { opacity: .55; }
+.brand-name { font-size: 17px; font-weight: 600; }
+.brand-beta {
+  padding: 3px 8px; border-radius: 999px; background: var(--fill);
+  font-size: 11px; font-weight: 600; line-height: 1.2; color: var(--label-2);
+}
+.side-label { margin: 26px 12px 8px; font-size: 12px; font-weight: 600; color: var(--label-2); }
+.side-nav { display: flex; flex-direction: column; gap: 2px; }
+.nav-item {
+  display: flex; align-items: center; gap: 10px; height: 40px; padding: 0 12px; border-radius: 12px;
+  font-size: 15px; font-weight: 500; transition: background .2s var(--ease), color .2s var(--ease);
+}
+.nav-item:hover { background: var(--fill); }
+.nav-icon { display: grid; place-items: center; color: var(--label-2); transition: color .2s var(--ease); }
+.nav-item.active { background: var(--accent-tint); color: var(--accent-text); }
+.nav-item.active .nav-icon { color: var(--accent-text); }
+.side-bottom { margin-top: auto; display: flex; align-items: center; gap: 10px; padding: 14px 12px 4px; border-top: .5px solid var(--sep); }
+.status-dot, .secure-indicator i {
+  width: 8px; height: 8px; flex: none; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px var(--green-tint);
+}
+.side-bottom strong, .side-bottom small { display: block; }
+.side-bottom strong { font-size: 13px; font-weight: 600; line-height: 1.3; }
+.side-bottom small { font-size: 12px; line-height: 1.3; color: var(--label-2); }
+
+.main-area { margin-left: 256px; min-height: 100vh; display: flex; flex-direction: column; }
+
+/* Top bar: a scroll-edge fade instead of a hard bar */
+.topbar {
+  position: sticky; top: 0; z-index: 10; height: 60px;
+  display: flex; align-items: center; justify-content: space-between; gap: 16px;
+  padding: 0 clamp(20px, 4vw, 48px);
+}
+.topbar::before {
+  content: ''; position: absolute; inset: 0 0 -14px 0; z-index: -1; pointer-events: none;
+  background: var(--bar-fill);
+  -webkit-backdrop-filter: blur(18px) saturate(1.5); backdrop-filter: blur(18px) saturate(1.5);
+  -webkit-mask-image: linear-gradient(#000 calc(100% - 26px), transparent); mask-image: linear-gradient(#000 calc(100% - 26px), transparent);
+}
+.topbar-brand { display: none; align-items: center; gap: 9px; font-size: 17px; font-weight: 600; }
+.breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--label-2); }
+.breadcrumb strong { font-weight: 600; color: var(--label); }
+.topbar-right { display: flex; align-items: center; gap: 14px; }
+.secure-indicator { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--label-2); }
+.avatar {
+  width: 30px; height: 30px; display: grid; place-items: center; border-radius: 50%;
+  background: linear-gradient(#8e8e93, #6e6e73); color: #fff; font-size: 13px; font-weight: 600;
+}
+
+.page-content { width: min(1040px, 100%); margin: 0 auto; padding: 12px clamp(20px, 4vw, 48px) 72px; flex: 1; outline: none; }
+.app-footer {
+  display: flex; align-items: center; justify-content: space-between; gap: 16px;
+  padding: 18px clamp(20px, 4vw, 48px) 28px; font-size: 12px; color: var(--label-2);
+}
+.app-footer span:first-child { font-weight: 600; color: var(--label); }
+
+/* ───────────── Surfaces ───────────── */
+.panel {
+  position: relative; background: var(--surface); border-radius: 24px;
+  box-shadow: 0 0 0 .5px var(--card-edge), 0 1px 2px rgba(0, 0, 0, .03);
+}
+@supports (corner-shape: squircle) {
+  .panel, .sidebar, .dropzone, .project-list, .empty-state, .workflow-strip, .table-scroll, .execution-message { corner-shape: squircle; }
+}
+
+/* ───────────── Typography ───────────── */
+.eyebrow { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; color: var(--label-2); }
+.page-lead { max-width: 560px; font-size: 17px; line-height: 1.47; color: var(--label-2); }
+.section-kicker { margin-bottom: 4px; font-size: 13px; font-weight: 600; color: var(--label-2); }
+.section-top h2, .projects-heading h2, .deliverables h2 { font-size: 22px; line-height: 1.2; font-weight: 700; letter-spacing: -.012em; }
+.section-top p, .deliverables p { margin-top: 4px; font-size: 15px; color: var(--label-2); }
+
+/* ───────────── Buttons ───────────── */
+.button {
+  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
+  min-height: 36px; padding: 0 18px; border: 0; border-radius: 999px;
+  font-size: 15px; font-weight: 600; line-height: 1; white-space: nowrap;
+  transition: background .2s var(--ease), transform .15s var(--ease), opacity .2s var(--ease);
+}
+.button:active:not(:disabled) { transform: scale(.97); }
+.button:disabled { opacity: .4; cursor: not-allowed; }
+.button-primary { background: var(--accent); color: #fff; }
+.button-primary:hover:not(:disabled) { background: var(--accent-hover); }
+.button-secondary { background: var(--fill); color: var(--accent-text); }
+.button-secondary:hover:not(:disabled) { background: var(--fill-hover); }
+.button-danger-ghost { background: var(--red-tint); color: var(--red-text); }
+.button-danger-ghost:hover:not(:disabled) { background: var(--red-tint); filter: brightness(.96); }
+.text-button { color: var(--accent-text); font-weight: 500; }
+.text-button:hover { text-decoration: underline; text-underline-offset: 3px; }
+.icon-button {
+  width: 36px; height: 36px; display: grid; place-items: center; flex: none; border-radius: 50%; color: var(--label-2);
+  transition: background .2s var(--ease), color .2s var(--ease);
+}
+.icon-button:hover { background: var(--red-tint); color: var(--red-text); }
+
+.inline-alert {
+  display: flex; align-items: flex-start; gap: 10px; margin-top: 16px; padding: 12px 14px; border-radius: 14px;
+  background: var(--red-tint); color: var(--red-text); font-size: 14px; font-weight: 500;
+}
+.inline-alert .icon { margin-top: 1px; }
+
+/* ───────────── Overview ───────────── */
+.overview-page, .job-page, .report-page { animation: fade-in .45s var(--ease) both; }
+.page-heading { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 44px 0 38px; }
+.page-heading h1 {
+  margin: 14px 0 16px; font-size: clamp(40px, 6vw, 64px); line-height: 1.05; font-weight: 700; letter-spacing: -.02em;
+}
+.page-heading h1 span {
+  display: inline-block; color: transparent;
+  background: linear-gradient(95deg, var(--ai-1) 0%, var(--ai-2) 28%, var(--ai-3) 56%, var(--ai-4) 78%, var(--ai-5) 100%);
+  -webkit-background-clip: text; background-clip: text;
+}
+.page-heading .page-lead { font-size: 19px; margin-inline: auto; }
+
+.upload-panel { padding: 28px; }
+.section-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 22px; }
+.step-pill {
+  display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px 5px 6px; border-radius: 999px;
+  background: var(--fill); font-size: 13px; font-weight: 600; color: var(--label-2); white-space: nowrap;
+}
+.step-pill span {
+  width: 20px; height: 20px; display: grid; place-items: center; border-radius: 50%;
+  background: var(--accent); color: #fff; font-size: 12px;
+}
+
+.dropzone {
+  position: relative; min-height: 224px; padding: 28px 20px; border-radius: 20px; background: var(--surface-2);
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; text-align: center;
+  transition: background .25s var(--ease), box-shadow .3s var(--ease);
+}
+.dropzone::before {
+  content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
+  border: 1.5px dashed var(--sep-strong); transition: opacity .2s var(--ease);
+}
+.dropzone.has-file { background: var(--accent-tint); }
+.dropzone.has-file::before { border-style: solid; border-color: var(--accent); }
+.dropzone:focus-within { box-shadow: 0 0 0 2px var(--accent); }
+
+/* The one signature: the Intelligence edge, shown only while AI-relevant work is happening
+   (dropping a recording, a stage running). */
+.dropzone::after, .stage-card::after {
+  content: ''; position: absolute; inset: -1.5px; border-radius: inherit; padding: 1.5px; pointer-events: none;
+  background: conic-gradient(from var(--ai-angle), var(--ai-g1), var(--ai-g2), var(--ai-g3), var(--ai-g4), var(--ai-g5), var(--ai-g1));
+  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
+  mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
+  opacity: 0; transition: opacity .3s var(--ease);
+}
+.dropzone.dragging { background: var(--accent-tint); box-shadow: 0 0 26px rgba(191, 90, 242, .28), 0 0 12px rgba(10, 132, 255, .28); }
+.dropzone.dragging::before { opacity: 0; }
+.dropzone.dragging::after, .stage-card.stage-running::after { opacity: 1; animation: ai-spin 4.5s linear infinite; }
+
+.file-input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
+.upload-symbol {
+  width: 56px; height: 56px; display: grid; place-items: center; margin-bottom: 10px; border-radius: 17px;
+  background: var(--accent-tint); color: var(--accent-text);
+}
+.drop-title { font-size: 17px; font-weight: 600; line-height: 1.3; word-break: break-all; }
+.drop-subtitle { font-size: 14px; color: var(--label-2); }
+.file-types { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; font-size: 12px; font-weight: 500; color: var(--label-2); }
+.file-types i { width: 3px; height: 3px; border-radius: 50%; background: var(--label-2); }
+
+.upload-actions { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 20px; }
+.privacy-note { display: flex; align-items: flex-start; gap: 8px; max-width: 480px; font-size: 13px; line-height: 1.45; color: var(--label-2); }
+.privacy-note .icon { margin-top: 2px; }
+
+.projects-section { margin-top: 48px; }
+.projects-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 14px; }
+.count-badge {
+  display: inline-grid; place-items: center; min-width: 24px; height: 24px; margin-left: 8px; padding: 0 8px; vertical-align: 3px;
+  border-radius: 999px; background: var(--fill); color: var(--label-2); font-size: 13px; font-weight: 600; letter-spacing: 0;
+}
+.updated-label { font-size: 13px; color: var(--label-2); }
+
+.project-list { overflow: hidden; border-radius: 22px; background: var(--surface); box-shadow: 0 0 0 .5px var(--card-edge), 0 1px 2px rgba(0, 0, 0, .03); }
+.project-row { position: relative; display: flex; align-items: center; gap: 14px; min-height: 68px; padding: 10px 12px 10px 16px; transition: background .2s var(--ease); }
+.project-row:hover { background: var(--surface-2); }
+.project-row + .project-row::before { content: ''; position: absolute; top: 0; left: 66px; right: 0; height: .5px; background: var(--sep); }
+.project-file-icon { width: 36px; height: 36px; display: grid; place-items: center; flex: none; border-radius: 10px; background: var(--accent-tint); color: var(--accent-text); }
+.project-meta { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1; }
+.project-name { font-size: 15px; font-weight: 600; }
+.project-id { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 500 12px var(--mono); color: var(--label-2); }
+.project-state { display: flex; align-items: center; gap: 8px; margin-right: 8px; font-size: 13px; color: var(--label-2); white-space: nowrap; }
+.project-state i { width: 7px; height: 7px; border-radius: 50%; background: var(--sep-strong); }
+.row-open { display: inline-flex; align-items: center; gap: 2px; font-size: 15px; font-weight: 500; color: var(--accent-text); }
+
+.empty-state {
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; min-height: 176px; padding: 28px;
+  border-radius: 22px; background: var(--surface); text-align: center; box-shadow: 0 0 0 .5px var(--card-edge), 0 1px 2px rgba(0, 0, 0, .03);
+}
+.empty-icon { width: 48px; height: 48px; display: grid; place-items: center; margin-bottom: 8px; border-radius: 15px; background: var(--fill); color: var(--label-2); }
+.empty-state strong { font-size: 17px; font-weight: 600; }
+.empty-state span { font-size: 14px; color: var(--label-2); }
+
+.workflow-strip {
+  display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 32px; padding: 18px 22px;
+  border-radius: 22px; background: var(--surface); box-shadow: 0 0 0 .5px var(--card-edge), 0 1px 2px rgba(0, 0, 0, .03);
+}
+.workflow-title { display: flex; align-items: center; gap: 12px; }
+.mini-spark { width: 36px; height: 36px; display: grid; place-items: center; flex: none; border-radius: 11px; background: var(--fill); color: var(--label-2); }
+.workflow-title strong, .workflow-title small { display: block; }
+.workflow-title strong { font-size: 15px; font-weight: 600; }
+.workflow-title small { font-size: 13px; color: var(--label-2); }
+.workflow-steps { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
+.workflow-steps li { display: inline-flex; align-items: center; gap: 8px; padding: 5px 13px 5px 6px; border-radius: 999px; background: var(--fill); font-size: 13px; }
+.workflow-steps em { width: 20px; height: 20px; display: grid; place-items: center; border-radius: 50%; background: var(--surface); color: var(--label-2); font-size: 12px; font-style: normal; font-weight: 600; }
+.workflow-steps b { font-weight: 600; }
+
+/* ───────────── Project workflow ───────────── */
+.back-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 8px 0 20px; }
+.back-row a { display: inline-flex; align-items: center; margin-left: -6px; font-size: 15px; font-weight: 500; color: var(--accent-text); }
+.back-row a:hover { text-decoration: underline; text-underline-offset: 3px; }
+.back-row span { font: 500 12px var(--mono); color: var(--label-2); }
+.job-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
+.job-heading h1 { margin: 10px 0; font-size: clamp(34px, 4.4vw, 46px); line-height: 1.08; font-weight: 700; letter-spacing: -.016em; }
+
+.progress-panel { margin-bottom: 36px; padding: 24px 26px 26px; }
+.progress-top { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
+.progress-top h2 { font-size: 34px; line-height: 1.1; font-weight: 700; letter-spacing: -.01em; font-variant-numeric: tabular-nums; }
+.progress-top h2 span { font-size: 15px; font-weight: 500; letter-spacing: 0; color: var(--label-2); }
+.progress-percent { font-size: 22px; font-weight: 700; color: var(--accent-text); font-variant-numeric: tabular-nums; }
+.progress-track { height: 8px; margin: 18px 0 24px; overflow: hidden; border-radius: 999px; background: var(--fill); }
+.progress-track span { display: block; height: 100%; border-radius: inherit; background: var(--accent); transition: width .6s var(--ease); }
+
+.stage-progress { display: grid; grid-template-columns: repeat(8, 1fr); gap: 8px; }
+.progress-step { display: flex; flex-direction: column; align-items: center; gap: 8px; font-size: 12px; font-weight: 500; text-align: center; color: var(--label-2); }
+.progress-step-icon {
+  width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: var(--fill);
+  font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; transition: background .3s var(--ease), color .3s var(--ease), box-shadow .3s var(--ease);
+}
+.progress-step.complete { color: var(--label); }
+.progress-step.complete .progress-step-icon { background: var(--green-tint); color: var(--green-text); }
+.progress-step.current { color: var(--accent-text); }
+.progress-step.current .progress-step-icon { background: var(--accent); color: #fff; box-shadow: 0 0 0 4px var(--accent-tint); }
+
+.stage-section { margin-bottom: 32px; }
+.stage-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
+.stage-card { display: flex; flex-direction: column; min-height: 212px; padding: 18px; transition: box-shadow .3s var(--ease); }
+.stage-card.stage-running { box-shadow: 0 0 0 .5px transparent, 0 0 26px rgba(191, 90, 242, .22), 0 0 12px rgba(10, 132, 255, .22); }
+.stage-card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
+.stage-icon { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 11px; background: var(--fill); color: var(--label-2); transition: background .3s var(--ease), color .3s var(--ease); }
+.stage-card.stage-done .stage-icon { background: var(--green-tint); color: var(--green-text); }
+.stage-card.stage-running .stage-icon { background: var(--accent-tint); color: var(--accent-text); }
+.stage-status { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 999px; background: var(--fill); font-size: 12px; font-weight: 600; color: var(--label-2); }
+.stage-status.done { background: var(--green-tint); color: var(--green-text); }
+.stage-status.running { background: var(--accent-tint); color: var(--accent-text); }
+.stage-index { margin: 18px 0 2px; font-size: 12px; font-weight: 500; color: var(--label-2); }
+.stage-card h3 { margin-bottom: 6px; font-size: 17px; line-height: 1.25; font-weight: 600; }
+.stage-card p { margin-bottom: 16px; font-size: 14px; line-height: 1.43; color: var(--label-2); }
+.stage-run-button { margin-top: auto; width: 100%; justify-content: space-between; }
+
+.spinner { width: 11px; height: 11px; border: 1.75px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: spin .8s linear infinite; }
+.execution-message {
+  display: flex; align-items: center; gap: 12px; margin: 0 0 32px; padding: 14px 18px; border-radius: 16px;
+  background: var(--surface); font-size: 14px; box-shadow: 0 0 0 .5px var(--card-edge), 0 1px 2px rgba(0, 0, 0, .03);
+}
+.message-pulse { width: 8px; height: 8px; flex: none; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-tint); animation: pulse 1.8s ease-in-out infinite; }
+
+.deliverables { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 22px 26px; }
+.deliverables h2 { font-size: 20px; }
+.deliverables p { max-width: 52ch; }
+.deliverable-actions { display: flex; flex-wrap: wrap; gap: 10px; }
+
+/* ───────────── Parity report ───────────── */
+.report-summary { display: flex; align-items: center; flex-wrap: wrap; gap: 28px; margin-bottom: 36px; padding: 26px 30px; }
+.parity-score { position: relative; width: 132px; height: 132px; flex: none; }
+.parity-score svg { width: 100%; height: 100%; transform: rotate(-90deg); }
+.ring-bg, .ring-fg { fill: none; stroke-width: 10; }
+.ring-bg { stroke: var(--fill); }
+.ring-fg { stroke-linecap: round; transition: stroke-dasharray .8s var(--ease); }
+.ring-fg.ok { stroke: var(--green); }
+.ring-fg.bad { stroke: var(--red); }
+.parity-value { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
+.parity-value strong { font-size: 28px; line-height: 1.1; font-weight: 700; letter-spacing: -.01em; font-variant-numeric: tabular-nums; }
+.parity-value small { margin-left: 1px; font-size: 14px; font-weight: 600; color: var(--label-2); }
+.parity-value span { margin-top: 2px; font-size: 12px; font-weight: 500; color: var(--label-2); }
+.report-summary-copy { flex: 1; min-width: 220px; }
+.report-summary-copy h2 { margin: 10px 0 6px; font-size: 26px; line-height: 1.15; font-weight: 700; letter-spacing: -.012em; }
+.report-summary-copy p { font-size: 15px; color: var(--label-2); }
+.result-chip, .verdict-chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px; font-size: 13px; font-weight: 600; }
+.result-pass, .verdict-good { background: var(--green-tint); color: var(--green-text); }
+.result-fail, .verdict-bad { background: var(--red-tint); color: var(--red-text); }
+.report-metric { padding-left: 28px; border-left: .5px solid var(--sep); }
+.report-metric strong { display: block; font-size: 34px; line-height: 1.1; font-weight: 700; letter-spacing: -.01em; font-variant-numeric: tabular-nums; }
+.report-metric span { font-size: 13px; color: var(--label-2); }
+
+.report-table-section { margin-top: 8px; }
+.table-scroll { overflow: auto; border-radius: 22px; background: var(--surface); box-shadow: 0 0 0 .5px var(--card-edge), 0 1px 2px rgba(0, 0, 0, .03); }
+.evidence-table { width: 100%; min-width: 1000px; border-collapse: separate; border-spacing: 0; font-size: 13px; font-variant-numeric: tabular-nums; }
+.evidence-table th { padding: 14px 12px; background: var(--surface-2); font-size: 12px; font-weight: 600; text-align: left; white-space: nowrap; color: var(--label-2); }
+.evidence-table td { max-width: 180px; padding: 14px 12px; border-top: .5px solid var(--sep); vertical-align: middle; }
+.evidence-table tbody tr { transition: background .15s var(--ease); }
+.evidence-table tbody tr:hover td { background: var(--surface-2); }
+.evidence-table td a { display: inline-flex; align-items: center; gap: 3px; font-weight: 500; color: var(--accent-text); }
+.evidence-table td a:hover { text-decoration: underline; text-underline-offset: 3px; }
+.step-number { font-family: var(--mono); color: var(--label-2); }
+.score-cell { font-weight: 700; }
+.reason-cell { max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--label-2); }
+.table-empty { margin-top: 0; }
+.verdict-chip { padding: 3px 10px; font-size: 12px; }
+
+.report-links { display: flex; justify-content: space-between; gap: 16px; margin-top: 24px; font-size: 15px; font-weight: 500; color: var(--accent-text); }
+.report-links a { display: inline-flex; align-items: center; gap: 3px; }
+.report-links a:hover { text-decoration: underline; text-underline-offset: 3px; }
+
+/* ───────────── Motion ───────────── */
+@keyframes fade-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
+@keyframes ai-spin { to { --ai-angle: 360deg; } }
+@keyframes spin { to { transform: rotate(360deg); } }
+@keyframes pulse { 0%, 100% { box-shadow: 0 0 0 3px var(--accent-tint); } 50% { box-shadow: 0 0 0 7px transparent; } }
+
+/* ───────────── Responsive ───────────── */
+/* Medium: the sidebar becomes an icon rail */
+@media (max-width: 1179px) {
+  .sidebar { width: 68px; padding: 16px 10px 14px; align-items: center; }
+  .brand { padding: 0; }
+  .brand-name, .brand-beta, .side-label, .nav-text, .side-bottom-text {
+    position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
+  }
+  .side-label { margin: 0; }
+  .side-nav { margin-top: 28px; align-items: center; }
+  .nav-item { width: 44px; height: 44px; padding: 0; justify-content: center; }
+  .side-bottom { padding: 14px 0 6px; }
+  .main-area { margin-left: 92px; }
+}
+@media (max-width: 960px) {
+  .stage-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .stage-progress { grid-template-columns: repeat(4, 1fr); row-gap: 18px; }
+}
+/* Compact: the sidebar becomes a floating tab bar */
+@media (max-width: 760px) {
+  .sidebar {
+    top: auto; left: 12px; right: 12px; width: auto; height: 64px; padding: 6px; border-radius: 32px;
+    bottom: max(12px, env(safe-area-inset-bottom)); flex-direction: row; align-items: stretch; justify-content: center;
+  }
+  .brand, .side-label, .side-bottom { display: none; }
+  .side-nav { flex: 1; flex-direction: row; margin: 0; gap: 4px; }
+  .nav-item { width: auto; height: 100%; flex: 1; flex-direction: column; justify-content: center; gap: 2px; border-radius: 26px; font-size: 11px; font-weight: 600; }
+  .nav-text { position: static; width: auto; height: auto; margin: 0; overflow: visible; clip: auto; }
+  .main-area { margin-left: 0; padding-bottom: 92px; }
+  .topbar-brand { display: flex; }
+  .breadcrumb { display: none; }
+  .page-heading { padding: 28px 0 28px; }
+  .upload-panel { padding: 20px 16px; }
+  .section-top { flex-direction: column; }
+  .upload-actions, .deliverables, .workflow-strip { align-items: stretch; flex-direction: column; }
+  .upload-actions .button, .deliverable-actions .button { width: 100%; }
+  .project-state, .row-open { display: none; }
+  .job-heading { align-items: flex-start; flex-direction: column; }
+  .progress-panel { padding: 20px 16px; }
+  .report-summary { padding: 22px 18px; gap: 20px; }
+  .report-metric { padding-left: 0; border-left: 0; }
+  .app-footer span:nth-child(2) { display: none; }
+}
+@media (max-width: 520px) {
+  .stage-grid { grid-template-columns: 1fr; }
+  .stage-card { min-height: 0; }
+}
+@media (pointer: coarse) {
+  .button { min-height: 44px; }
+  .nav-item { min-height: 44px; }
+}
+
+/* ───────────── Accessibility ───────────── */
+/* Reduce Transparency, or no backdrop-filter support: opaque fallbacks */
+@media (prefers-reduced-transparency: reduce) {
+  .glass, .sidebar { background: var(--surface); -webkit-backdrop-filter: none; backdrop-filter: none; }
+  .topbar::before { background: var(--bg); -webkit-backdrop-filter: none; backdrop-filter: none; }
+}
+@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
+  .glass, .sidebar { background: var(--surface); }
+  .topbar::before { background: var(--bg); }
+}
+/* Increase Contrast: stronger text, borders and fills */
+@media (prefers-contrast: more) {
+  :root { --label-2: #3c3c43; --sep: rgba(60, 60, 67, .5); --sep-strong: rgba(60, 60, 67, .7); --card-edge: rgba(0, 0, 0, .4); --fill: rgba(120, 120, 128, .24); }
+}
+@media (prefers-contrast: more) and (prefers-color-scheme: dark) {
+  :root { --label-2: #d1d1d6; --sep: rgba(235, 235, 245, .4); --sep-strong: rgba(235, 235, 245, .6); --card-edge: rgba(255, 255, 255, .4); --fill: rgba(120, 120, 128, .4); }
+}
+/* Reduce Motion: no spinning edge, no pulse, no entrance animation */
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
+}
